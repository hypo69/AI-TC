{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Единая конфигурация телеметрии: сенсоры, логгеры приложений и опции сбора данных",
  "storage": {
    "data_path": "%ProgramData%/ai-tc/telemetry",
    "db_path": "%ProgramData%/ai-tc/telemetry/telemetry.db"
  },
  "data_path": "%ProgramData%/ai-tc/telemetry",
  "mode": "audit",
  "telemetry_mode": "audit",
  "audit_enabled": true,
  "streaming_enabled": false,
  "standard_flush_interval_seconds": 30.0,
  "tc_flush_interval_seconds": 5.0,
  "tc_mode_timeout_seconds": 300.0,
  "tc_mode_activated_at": null,
  "buffer_mode": "memory",
  "buffer_size": 50,
  "flush_interval_seconds": 30.0,
  "buffer_file": "telemetry_buffer.jsonl",
  "max_db_size_mb": 50.0,
  "retention_days": 3,
  "db_cleanup_interval_seconds": 120.0,
  "auto_vacuum_enabled": true,
  "interval_seconds": 6.0,
  "heavy_interval_seconds": 90.0,
  "wmi_interval_sec": 120,
  "smart_interval_sec": 300,
  "handles_interval_sec": 60,
  "network_ports_interval_sec": 30,
  "process_mode": "top_n",
  "top_processes": 10,
  "low_priority": true,
  "fast_interval_seconds": 3.0,
  "fast_duration_days": 2,
  "aggregation_interval_seconds": 3600,
  "max_file_size_mb": 50,
  "max_measurements": null,
  "heavy_disk_scan_interval_seconds": 43200,
  "heavy_mode_max_duration_days": 5,
  "heavy_mode_auto_switch_enabled": true,
  "watch_directories": [
    "C:\\Users\\"
  ],
  "log_filename": "ai_sensors_polls.json",
  "collect_serial_numbers": true,
  "collect_hardware_inventory": false,
  "collect_file_events": false,
  "heavy_collectors": {
    "hardware_sensors": true,
    "storage_smart": true,
    "network_ping": true,
    "inventory_wmi": true,
    "security_events": false
  },
  "sensors": {
    "cpu": {
      "enabled": true,
      "interval_seconds": 5.0,
      "metrics": [
        "temperature",
        "load",
        "clocks"
      ]
    },
    "gpu": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "load",
        "memory",
        "power"
      ]
    },
    "ram": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "usage",
        "swap"
      ]
    },
    "disk": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "usage",
        "io"
      ]
    },
    "network": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "throughput",
        "connections"
      ]
    },
    "sensors": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "fan",
        "voltage"
      ]
    },
    "internet": {
      "enabled": true,
      "interval_seconds": 3600.0,
      "metrics": [
        "ping",
        "download",
        "upload",
        "bufferbloat",
        "latency_loaded"
      ]
    },
    "storage": {
      "enabled": true,
      "interval_seconds": 32000.0,
      "metrics": [
        "smart_attributes",
        "temperature",
        "wear_level"
      ]
    },
    "device_flapping": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "connect_events",
        "disconnect_events",
        "flapping_count"
      ]
    }
  },
  "telemetry_options": {
    "collect_serial_numbers": true,
    "collect_hardware_inventory": true,
    "collect_file_events": true,
    "max_file_size_mb": 50,
    "watch_directories": [
      "C:\\Users\\"
    ]
  },
  "w64_collector": {
    "enabled": false,
    "enable_file_monitoring": false,
    "enable_process_monitoring": false,
    "enable_registry_monitoring": false,
    "enable_network_monitoring": false,
    "enable_event_log_monitoring": false,
    "enable_process_trace": false,
    "enable_disk_trace": false,
    "enable_network_trace": false,
    "enable_registry_trace": false
  },
  "multi_rate_engine": {
    "enabled": true,
    "level3_realtime_interval_seconds": 1.0,
    "level2_adaptive_initial_interval_seconds": 2.0,
    "level2_adaptive_min_interval_seconds": 0.5,
    "level2_adaptive_max_interval_seconds": 30.0,
    "level2_cooldown_ticks": 10,
    "level2_backoff_multiplier": 1.5,
    "level1_smart_interval_seconds": 43200.0,
    "level1_battery_interval_seconds": 900.0,
    "level1_security_interval_seconds": 3600.0,
    "level1_scm_interval_seconds": 1800.0,
    "level1_schedule_check_interval_seconds": 60.0,
    "wal_flush_interval_seconds": 5.0,
    "ring_buffer_capacity": 600,
    "ring_buffer_max_mb": 32,
    "deadband": {
      "temperature_c": 1.0,
      "cpu_load_pct": 3.0,
      "freq_mhz": 50.0,
      "power_w": 2.0,
      "fan_rpm": 100.0,
      "network_bytes": 10485760.0,
      "network_packets": 10000.0,
      "disk_space_gb": 0.5,
      "default_threshold": 2.0,
      "heartbeat_interval_seconds": 60.0,
      "ignore_cumulative_network_spikes": true
    }
  },
  "cache_ttls": {
    "acpi_thermal_ttl_sec": 15.0,
    "storage_smart_ttl_sec": 30.0,
    "cloud_storage_ttl_sec": 120.0,
    "internet_speed_ttl_sec": 1800.0,
    "network_adapter_stats_ttl_sec": 15.0,
    "physical_disks_health_ttl_sec": 43200.0,
    "forensics_consent_store_ttl_sec": 60.0,
    "forensics_userassist_ttl_sec": 300.0,
    "gpu_probe_ttl_sec": 10.0,
    "disk_partitions_ttl_sec": 60.0
  },
  "thresholds": {
    "incident_cpu_pct": 90.0,
    "incident_cpu_critical_pct": 95.0,
    "incident_disk_write_burst_mb_s": 100.0,
    "incident_net_burst_mb_s": 50.0,
    "incident_cooldown_seconds": 60.0,
    "incident_window_before_seconds": 300.0,
    "suspicious_temp_cpu_pct": 15.0,
    "suspicious_temp_critical_cpu_pct": 30.0,
    "individual_process_high_cpu_pct": 50.0,
    "leak_candidate_handles": 250,
    "leak_candidate_memory_mb": 80.0,
    "leak_warning_handles": 1500,
    "leak_critical_handles": 4000,
    "leak_severe_handles": 10000,
    "leak_warning_gdi": 800,
    "leak_critical_gdi": 2000,
    "leak_warning_user_objects": 500,
    "leak_high_page_faults": 2000000,
    "leak_high_memory_mb": 2048.0,
    "dpc_elevated_pct": 1.5,
    "dpc_severe_pct": 5.0,
    "interrupt_elevated_pct": 1.0,
    "interrupt_severe_pct": 3.0,
    "leaks_scan_every_n_ticks": 10
  },
  "sampling_controller": {
    "forensic_interval_sec": 0.25,
    "forensic_duration_sec": 300.0,
    "incident_interval_sec": 1.0,
    "incident_duration_sec": 1200.0,
    "boot_phase1_max_uptime_sec": 600.0,
    "boot_phase1_interval_sec": 1.0,
    "boot_phase2_max_uptime_sec": 3600.0,
    "boot_phase2_interval_sec": 5.0,
    "boot_phase3_max_uptime_sec": 86400.0,
    "boot_phase3_interval_sec": 30.0,
    "monitoring_interval_sec": 30.0,
    "normal_interval_sec": 60.0
  },
  "light_poll_interval_seconds": 6.0,
  "heavy_poll_interval_seconds": 90.0,
  "heavy_polls_intervals": {
    "hardware_audit_interval_sec": 90.0,
    "startup_audit_interval_sec": 180.0,
    "extended_audit_interval_sec": 300.0,
    "defender_audit_interval_sec": 120.0,
    "process_activity_sync_interval_sec": 60.0,
    "software_audit_interval_sec": 3600.0,
    "wmi_interval_sec": 120.0,
    "smart_interval_sec": 300.0,
    "handles_interval_sec": 60.0,
    "network_ports_interval_sec": 30.0,
    "disk_scan_interval_sec": 43200.0
  }
}